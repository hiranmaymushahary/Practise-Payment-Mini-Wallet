generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
 
}

enum TransactionStatus {
  PENDING
  DEBITED
  CREDITED
  FAILED
}

enum LedgerType {
  CREDIT
  DEBIT
}

model Wallet {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  userId     BigInt   @unique @db.BigInt
  balance    BigInt   @default(0) @db.BigInt
  version    Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([userId], name: "idx__user_id")
  @@map("wallets")
}

model Transaction {
  id              BigInt            @id @default(autoincrement()) @db.BigInt
  from_user       BigInt            @db.BigInt
  to_user         BigInt            @db.BigInt
  amount          BigInt            @db.BigInt
  status          TransactionStatus @default(PENDING)
  idempotency_key String            @unique @db.VarChar(255)
  created_at      DateTime          @default(now())

  @@index([from_user], name: "idx__from_user")
  @@index([to_user], name: "idx__to_user")
  @@index([status], name: "idx__status")
  @@index([idempotency_key], name: "idx__idempotency_key")
  @@map("transactions")
}

model Ledger {
  id             BigInt     @id @default(autoincrement()) @db.BigInt
  user_id        BigInt     @db.BigInt
  transaction_id BigInt     @db.BigInt
  amount         BigInt     @db.BigInt
  type           LedgerType
  created_at     DateTime   @default(now())

  @@index([user_id], name: "idx__user_id")
  @@index([transaction_id], name: "idx__transaction_id")
  @@index([created_at], name: "idx__created_at")
  @@map("ledgers")
}